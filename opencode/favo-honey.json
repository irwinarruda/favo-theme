{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "accentText": "#F5A623",
    "background": "#14110B",
    "border": "#3A3122",
    "comment": "#A3937A",
    "constant": "#BC9DFB",
    "diffAddedBackground": "#32381D",
    "diffRemovedBackground": "#39211A",
    "float": "#0F0D08",
    "foreground": "#F3E7CF",
    "function": "#74C7FF",
    "keyword": "#FCAF41",
    "panel": "#1B170F",
    "param": "#F898C3",
    "raised": "#221D14",
    "regex": "#F9786A",
    "string": "#B8EC6D",
    "type": "#77EDD1",
    "warning": "#FFC857"
  },
  "theme": {
    "primary": {
      "dark": "accentText",
      "light": "accentText"
    },
    "secondary": {
      "dark": "param",
      "light": "param"
    },
    "accent": {
      "dark": "type",
      "light": "type"
    },
    "error": {
      "dark": "regex",
      "light": "regex"
    },
    "warning": {
      "dark": "warning",
      "light": "warning"
    },
    "success": {
      "dark": "string",
      "light": "string"
    },
    "info": {
      "dark": "function",
      "light": "function"
    },
    "text": {
      "dark": "foreground",
      "light": "foreground"
    },
    "textMuted": {
      "dark": "comment",
      "light": "comment"
    },
    "background": {
      "dark": "background",
      "light": "background"
    },
    "backgroundPanel": {
      "dark": "panel",
      "light": "panel"
    },
    "backgroundElement": {
      "dark": "raised",
      "light": "raised"
    },
    "border": {
      "dark": "border",
      "light": "border"
    },
    "borderActive": {
      "dark": "accentText",
      "light": "accentText"
    },
    "borderSubtle": {
      "dark": "float",
      "light": "float"
    },
    "diffAdded": {
      "dark": "string",
      "light": "string"
    },
    "diffRemoved": {
      "dark": "regex",
      "light": "regex"
    },
    "diffContext": {
      "dark": "comment",
      "light": "comment"
    },
    "diffHunkHeader": {
      "dark": "comment",
      "light": "comment"
    },
    "diffHighlightAdded": {
      "dark": "string",
      "light": "string"
    },
    "diffHighlightRemoved": {
      "dark": "regex",
      "light": "regex"
    },
    "diffAddedBg": {
      "dark": "diffAddedBackground",
      "light": "diffAddedBackground"
    },
    "diffRemovedBg": {
      "dark": "diffRemovedBackground",
      "light": "diffRemovedBackground"
    },
    "diffContextBg": {
      "dark": "panel",
      "light": "panel"
    },
    "diffLineNumber": {
      "dark": "comment",
      "light": "comment"
    },
    "diffAddedLineNumberBg": {
      "dark": "diffAddedBackground",
      "light": "diffAddedBackground"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diffRemovedBackground",
      "light": "diffRemovedBackground"
    },
    "markdownText": {
      "dark": "foreground",
      "light": "foreground"
    },
    "markdownHeading": {
      "dark": "accentText",
      "light": "accentText"
    },
    "markdownLink": {
      "dark": "function",
      "light": "function"
    },
    "markdownLinkText": {
      "dark": "param",
      "light": "param"
    },
    "markdownCode": {
      "dark": "string",
      "light": "string"
    },
    "markdownBlockQuote": {
      "dark": "comment",
      "light": "comment"
    },
    "markdownEmph": {
      "dark": "constant",
      "light": "constant"
    },
    "markdownStrong": {
      "dark": "keyword",
      "light": "keyword"
    },
    "markdownHorizontalRule": {
      "dark": "comment",
      "light": "comment"
    },
    "markdownListItem": {
      "dark": "accentText",
      "light": "accentText"
    },
    "markdownListEnumeration": {
      "dark": "type",
      "light": "type"
    },
    "markdownImage": {
      "dark": "function",
      "light": "function"
    },
    "markdownImageText": {
      "dark": "param",
      "light": "param"
    },
    "markdownCodeBlock": {
      "dark": "foreground",
      "light": "foreground"
    },
    "syntaxComment": {
      "dark": "comment",
      "light": "comment"
    },
    "syntaxKeyword": {
      "dark": "keyword",
      "light": "keyword"
    },
    "syntaxFunction": {
      "dark": "function",
      "light": "function"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "foreground"
    },
    "syntaxString": {
      "dark": "string",
      "light": "string"
    },
    "syntaxNumber": {
      "dark": "constant",
      "light": "constant"
    },
    "syntaxType": {
      "dark": "type",
      "light": "type"
    },
    "syntaxOperator": {
      "dark": "keyword",
      "light": "keyword"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "foreground"
    }
  }
}
