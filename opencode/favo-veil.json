{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "accentText": "#8F5600",
    "background": "#F7F5F1",
    "border": "#D2CEC4",
    "comment": "#67635C",
    "constant": "#7145B5",
    "diffAddedBackground": "#D7DFCA",
    "diffRemovedBackground": "#EFD8D1",
    "float": "#FCFAF7",
    "foreground": "#2D2A26",
    "function": "#1F62A4",
    "keyword": "#915100",
    "panel": "#EEEBE5",
    "param": "#AA3069",
    "raised": "#E6E2DA",
    "regex": "#C43E27",
    "string": "#477C18",
    "type": "#007D70",
    "warning": "#8F5600"
  },
  "theme": {
    "primary": {
      "dark": "accentText",
      "light": "accentText"
    },
    "secondary": {
      "dark": "param",
      "light": "param"
    },
    "accent": {
      "dark": "type",
      "light": "type"
    },
    "error": {
      "dark": "regex",
      "light": "regex"
    },
    "warning": {
      "dark": "warning",
      "light": "warning"
    },
    "success": {
      "dark": "string",
      "light": "string"
    },
    "info": {
      "dark": "function",
      "light": "function"
    },
    "text": {
      "dark": "foreground",
      "light": "foreground"
    },
    "textMuted": {
      "dark": "comment",
      "light": "comment"
    },
    "background": {
      "dark": "background",
      "light": "background"
    },
    "backgroundPanel": {
      "dark": "panel",
      "light": "panel"
    },
    "backgroundElement": {
      "dark": "raised",
      "light": "raised"
    },
    "border": {
      "dark": "border",
      "light": "border"
    },
    "borderActive": {
      "dark": "accentText",
      "light": "accentText"
    },
    "borderSubtle": {
      "dark": "float",
      "light": "float"
    },
    "diffAdded": {
      "dark": "string",
      "light": "string"
    },
    "diffRemoved": {
      "dark": "regex",
      "light": "regex"
    },
    "diffContext": {
      "dark": "comment",
      "light": "comment"
    },
    "diffHunkHeader": {
      "dark": "comment",
      "light": "comment"
    },
    "diffHighlightAdded": {
      "dark": "string",
      "light": "string"
    },
    "diffHighlightRemoved": {
      "dark": "regex",
      "light": "regex"
    },
    "diffAddedBg": {
      "dark": "diffAddedBackground",
      "light": "diffAddedBackground"
    },
    "diffRemovedBg": {
      "dark": "diffRemovedBackground",
      "light": "diffRemovedBackground"
    },
    "diffContextBg": {
      "dark": "panel",
      "light": "panel"
    },
    "diffLineNumber": {
      "dark": "comment",
      "light": "comment"
    },
    "diffAddedLineNumberBg": {
      "dark": "diffAddedBackground",
      "light": "diffAddedBackground"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diffRemovedBackground",
      "light": "diffRemovedBackground"
    },
    "markdownText": {
      "dark": "foreground",
      "light": "foreground"
    },
    "markdownHeading": {
      "dark": "accentText",
      "light": "accentText"
    },
    "markdownLink": {
      "dark": "function",
      "light": "function"
    },
    "markdownLinkText": {
      "dark": "param",
      "light": "param"
    },
    "markdownCode": {
      "dark": "string",
      "light": "string"
    },
    "markdownBlockQuote": {
      "dark": "comment",
      "light": "comment"
    },
    "markdownEmph": {
      "dark": "constant",
      "light": "constant"
    },
    "markdownStrong": {
      "dark": "keyword",
      "light": "keyword"
    },
    "markdownHorizontalRule": {
      "dark": "comment",
      "light": "comment"
    },
    "markdownListItem": {
      "dark": "accentText",
      "light": "accentText"
    },
    "markdownListEnumeration": {
      "dark": "type",
      "light": "type"
    },
    "markdownImage": {
      "dark": "function",
      "light": "function"
    },
    "markdownImageText": {
      "dark": "param",
      "light": "param"
    },
    "markdownCodeBlock": {
      "dark": "foreground",
      "light": "foreground"
    },
    "syntaxComment": {
      "dark": "comment",
      "light": "comment"
    },
    "syntaxKeyword": {
      "dark": "keyword",
      "light": "keyword"
    },
    "syntaxFunction": {
      "dark": "function",
      "light": "function"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "foreground"
    },
    "syntaxString": {
      "dark": "string",
      "light": "string"
    },
    "syntaxNumber": {
      "dark": "constant",
      "light": "constant"
    },
    "syntaxType": {
      "dark": "type",
      "light": "type"
    },
    "syntaxOperator": {
      "dark": "keyword",
      "light": "keyword"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "foreground"
    }
  }
}
